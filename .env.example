# Copy to .env (never commit .env). All configuration comes from environment variables.

# PostgreSQL connection (local docker-compose or Neon). Neon example:
# Host=ep-xxx.sa-east-1.aws.neon.tech;Database=ideavault;Username=xxx;Password=xxx;SSL Mode=Require
ConnectionStrings__Default=Host=localhost;Port=5432;Database=ideavault;Username=postgres;Password=postgres

# Password for the single user (login screen)
APP_PASSWORD=change-me

# Secret used to sign JWTs - at least 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
