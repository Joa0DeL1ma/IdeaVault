<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Low memory footprint for a single-user app on a 512 MB free instance. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only settings never ship in the production image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdeaVault.Core\IdeaVault.Core.csproj" />
    <ProjectReference Include="..\IdeaVault.Infra\IdeaVault.Infra.csproj" />
    <ProjectReference Include="..\IdeaVault.Web\IdeaVault.Web.csproj" />
  </ItemGroup>

</Project>
